{
  "name": "@local/gui-launch-env-fix",
  "version": "1.0.0",
  "private": true,
  "description": "Strips the inherited ELECTRON_RUN_AS_NODE from detached GUI launches so Open in VS Code and similar applications show their window",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "intercept.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/intercept.test.mjs && node test/integration.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
