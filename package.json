{
  "name": "@local/gui-launch-env-fix",
  "version": "1.0.1",
  "private": true,
  "description": "DSH plugin that strips the inherited ELECTRON_RUN_AS_NODE from detached GUI launches so Open in VS Code and similar applications show their window",
  "type": "module",
  "author": "ailawu0409",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailawu0409/dsh-open-gui-fix.git"
  },
  "homepage": "https://github.com/ailawu0409/dsh-open-gui-fix#readme",
  "bugs": {
    "url": "https://github.com/ailawu0409/dsh-open-gui-fix/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "electron",
    "vscode",
    "open-in"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "CHANGELOG.md",
    "intercept.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/intercept.test.mjs && node test/integration.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
